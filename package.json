{
  "name": "mirocode",
  "version": "0.14.0",
  "description": "A multi-agent ACP terminal client built with React + Ink",
  "type": "module",
  "bin": {
    "miro": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/codemode-worker.js",
    "dist/*.wasm"
  ],
  "scripts": {
    "start": "bun run src/main.ts",
    "build": "bun run scripts/build.ts",
    "build:js": "bun run scripts/build-js.ts",
    "tui": "dist/miro",
    "prepack": "bun run build:js"
  },
  "keywords": [
    "cli",
    "tui",
    "agent",
    "acp",
    "ink",
    "terminal"
  ],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metowolf/miro.git"
  },
  "homepage": "https://github.com/metowolf/miro",
  "bugs": {
    "url": "https://github.com/metowolf/miro/issues"
  },
  "engines": {
    "bun": ">=1.4.3",
    "node": ">=22.7.0"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^1.8.0",
    "@anthropic-ai/sandbox-runtime": "0.0.79",
    "@cfworker/json-schema": "4.1.1",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-codemode": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "chalk": "^6.0.1",
    "diff": "^9.0.0",
    "ignore": "7.0.12",
    "ink": "^8.0.0",
    "marked": "^18.1.0",
    "react": "^19.3.0",
    "wrap-ansi": "^10.0.2",
    "yaml": "2.9.1",
    "zustand": "^5.0.15"
  }
}
